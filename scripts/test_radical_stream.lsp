(defun c:radical_drafting_aids_toggle ()
  (princ "\nSetting global linetype scale LTSCALE=2.0...")
  (setvar "LTSCALE" 2.0)
  (princ "\nSetting entity transparency CETRANSPARENCY=50...")
  (setvar "CETRANSPARENCY" 50)
  (princ "\nToggling GRID and SNAP...")
  (command "_.GRID")
  (command "_.SNAP")
  (princ "\nTriggering display cache regeneration via REGEN...")
  (command "_.REGEN")
  ;; Restore transparency
  (setvar "CETRANSPARENCY" "ByLayer")
  (princ "\nDrafting aids and system variables test complete!")
  (princ)
)

