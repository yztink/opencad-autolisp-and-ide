(defun c:radical_ucs_transform ()
  (princ "\nSetting UCS origin to (60, 60)...")
  (command "_.UCS" "ORIGIN" '(60.0 60.0 0.0))
  (princ "\nDrawing local 40x40 square in shifted UCS...")
  (command "_.LINE" '(0.0 0.0 0.0) '(40.0 0.0 0.0) '(40.0 40.0 0.0) '(0.0 40.0 0.0) "C")
  
  (princ "\nRotating UCS around Z axis by 45 degrees...")
  (command "_.UCS" "Z" 45.0)
  (princ "\nDrawing local 40x40 square in rotated UCS...")
  (command "_.LINE" '(0.0 0.0 0.0) '(40.0 0.0 0.0) '(40.0 40.0 0.0) '(0.0 40.0 0.0) "C")
  
  (princ "\nRestoring World Coordinate System (UCS W)...")
  (command "_.UCS" "W")
  (princ "\nUCS transform sequence completed successfully!")
  (princ)
)

