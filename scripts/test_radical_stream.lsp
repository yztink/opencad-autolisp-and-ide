(defun c:radical_donut_targets ()
  (princ "\nStreaming concentric donuts via DONUT...")
  (command "_.DONUT" 10.0 30.0 '(0.0 0.0 0.0) '(80.0 0.0 0.0) "")
  (princ "\nDONUT targets successfully streamed!")
  (princ)
)

(defun c:radical_point_and_style (/ points pt)
  (princ "\nSetting point display mode PDMODE=35 (circle + X) and PDSIZE=5.0...")
  (setvar "PDMODE" 35)
  (setvar "PDSIZE" 5.0)
  (princ "\nStreaming survey points via POINT...")
  (setq points '((10.0 10.0 0.0) (30.0 20.0 0.0) (50.0 40.0 0.0) (70.0 70.0 0.0) (90.0 110.0 0.0)))
  (foreach pt points
    (command "_.POINT" pt)
  )
  (princ (strcat "\nStreamed " (itoa (length points)) " styled POINT entities!"))
  (princ)
)

(defun c:radical_ray_horizon ()
  (princ "\nStreaming semi-infinite rays from (0, 0)...")
  (command "_.RAY" '(0.0 0.0 0.0) '(100.0 20.0 0.0) '(100.0 50.0 0.0) '(100.0 80.0 0.0) '(50.0 100.0 0.0) "")
  (princ "\nProjection rays completed!")
  (princ)
)

(defun c:radical_ellipse_orbit ()
  (princ "\nStreaming elliptical orbits...")
  (command "_.ELLIPSE" '(0.0 0.0 0.0) '(100.0 0.0 0.0) 40.0)
  (command "_.ELLIPSE" '(0.0 0.0 0.0) '(0.0 80.0 0.0) 30.0)
  (command "_.ELLIPSE" '(0.0 0.0 0.0) '(70.0 70.0 0.0) 25.0)
