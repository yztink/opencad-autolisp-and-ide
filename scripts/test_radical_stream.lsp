  (command "_.ARC" '(0.0 0.0 0.0) '(50.0 40.0 0.0) '(100.0 0.0 0.0))
  (princ "\nStreaming lower arch via ARC...")
  (command "_.ARC" '(0.0 0.0 0.0) '(50.0 -40.0 0.0) '(100.0 0.0 0.0))
  (princ "\nStreaming S-curve via ARC...")
  (command "_.ARC" '(100.0 0.0 0.0) '(125.0 25.0 0.0) '(150.0 0.0 0.0))
  (command "_.ARC" '(150.0 0.0 0.0) '(175.0 -25.0 0.0) '(200.0 0.0 0.0))
  (princ "\nArc triptych complete!")
